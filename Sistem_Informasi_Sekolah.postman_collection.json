            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "http://localhost:8080/api/schedules", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "schedules"] }
          }
        },
        {
          "name": "Get My Teacher Schedule",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "http://localhost:8080/api/schedules/my-schedule", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "schedules", "my-schedule"] }
