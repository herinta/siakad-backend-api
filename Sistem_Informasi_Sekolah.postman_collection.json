        {
          "name": "Get All Subjects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "http://localhost:8080/api/subjects", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "subjects"] }
          }
        },
        {
