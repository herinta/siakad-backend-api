    {
      "name": "4. Reports & Transcripts",
      "item": [
        {
          "name": "Get Rapor UTS Siswa 1",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "http://localhost:8080/api/reports/midterm?studentId=1&academicYear=2026/2027&semester=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "reports", "midterm"],
              "query": [
                { "key": "studentId", "value": "1" },
                { "key": "academicYear", "value": "2026/2027" },
                { "key": "semester", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Get Rapor Akhir Semester Siswa 1",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "http://localhost:8080/api/reports/final?studentId=1&academicYear=2026/2027&semester=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "reports", "final"],
              "query": [
                { "key": "studentId", "value": "1" },
                { "key": "academicYear", "value": "2026/2027" },
                { "key": "semester", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Get Transkrip Nilai Kumulatif SMP Siswa 1",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "http://localhost:8080/api/reports/transcript/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "reports", "transcript", "1"] }
          }
        }
      ]
    }
  ]
